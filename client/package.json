{
    "name": "dhis2-cert-client",
    "private": true,
    "version": "0.6.1",
    "scripts": {
        "start": "vite --port 3000",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "start:e2e": "npm run build && vite preview --host 127.0.0.1 --port 3000 --strictPort",
        "test": "jest --passWithNoTests",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:codegen": "playwright codegen http://localhost:3000",
        "test:e2e:report": "playwright show-report",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@dhis2/app-runtime": "^3.17.0",
        "@dhis2/app-service-alerts": "^3.16.0",
        "@dhis2/data-engine": "3.17.0",
        "@dhis2/ui": "^10.12.11",
        "@dhis2/ui-constants": "^10.12.11",
        "@fontsource/roboto": "^5.2.10",
        "axios": "^1.13.6",
        "axios-hooks": "^5.1.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router": "^6.28.1",
        "react-router-dom": "^6.26.2",
        "styled-jsx": "5.1.7",
        "yaml": "^2.8.2"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-react": "^8.0.1",
        "@playwright/test": "^1.62.0",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.5.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.1",
        "@types/react": "^18.3.10",
        "@types/react-dom": "^18.3.0",
        "@types/react-router-dom": "^5.3.3",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitejs/plugin-react": "^6.0.4",
        "dotenv": "^17.4.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.30.0",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "jest": "^30.4.2",
        "prettier": "^3.9.6",
        "ts-jest": "^29.4.12",
        "typescript": "7.0.2",
        "vite": "^8.1.5"
    }
}
