PROJECT_NAME="DHIS2 Certification API"

SECRETS_DIR=./secrets
STACK_NAME=dhis2-cert-local

DHIS2_CERT_API_IMAGE=ghcr.io/dhis2/certification-app/api
DHIS2_CERT_CLIENT_IMAGE=ghcr.io/dhis2/certification-app/client
TAG=local
CLIENT_TAG=local

CREATE_EMPTY_MIGRATION=false
SKIP_MIGRATIONS=false

# SERVER
NODE_ENV=development
PORT=3001
TRUST_PROXY=1

# DATABASE
DB_HOST=dhis2-cert-db
DB_PORT=5432
DB_USER=postgres
DB_NAME=dhis2_certification
DB_SSL=false
# Staging/production (compose.prod.yaml): Compose mounts files; API/migrations read these paths.
# DB_PASSWORD_FILE=/run/secrets/db_password

# JWT AUTHENTICATION
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# OTP (AES-256): exactly 64 hex characters (32 bytes). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_APP_NAME=DHIS2-CERTIFICATION
OTP_ENCRYPTION_KEY=

CORS_ORIGIN=http://localhost:3000

APP_BASE_URL=http://localhost:3001

# AUDIT — HMAC chain (production: file; local dev: set in section below).
# AUDIT_LOG_HMAC_KEY_FILE=/run/secrets/audit_log_hmac_key

# CERTIFICATE_DEFAULTS (optional; API validates ranges)
# CERTIFICATE_VALIDITY_DAYS=730
# CERTIFICATE_RENEWAL_REMINDER_DAYS=60

# SEEDING
RUN_SEEDS=true
# SEED_ADMIN_PASSWORD_FILE=/run/secrets/seed_admin_password

# SESSION TIMEOUTS (NIST SP 800-63B-4 / OWASP Session Management)
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200

REDIS_HOST=dhis2-cert-redis
REDIS_PORT=6379
# REDIS_PASSWORD_FILE=/run/secrets/redis_password

# Vault (Transit/KV): deprecated — VC signing paths removed on refactor/simplify-cert; optional keys may still validate in API. See staging plan Phase 8 if reintroducing.
# USE_VAULT=false
# VAULT_ADDR=http://vault:8200
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=

JWT_TOKEN_AUDIENCE=dhis2-cert-api
JWT_TOKEN_ISSUER=dhis2-cert-api

DOMAIN=localhost

MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=DHIS2 Server Certification
MAIL_FROM_ADDRESS=no-reply@dhis2.org


DB_PASSWORD=postgres
REDIS_PASSWORD=changeme-local-dev-only
JWT_SECRET=secure-random-secret-that-is-at-least-32-characters-long
# Dev-only base64 HMAC key (32 random bytes): openssl rand -base64 32
AUDIT_LOG_HMAC_KEY=eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHg=
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=changeme-local-dev-only
